# Deployment settings only. No cloud model provider or fallback is configured.
APARTMINT_CONFIG=config/sources.json
APARTMINT_DATA_DIR=data
APARTMINT_MODEL_BASE_URL=http://127.0.0.1:11437/v1
APARTMINT_MODEL=apartmint-qwen3
APARTMINT_BROKER_URL=redis://127.0.0.1:16379/0
APARTMINT_POLL_SECONDS=900
APARTMINT_MAX_SNAPSHOT_AGE_SECONDS=1800
# CUDA deployment; install the matching model before starting Compose.
APARTMINT_MODEL_DIR=./models/qwen3-8b-nvfp4
APARTMINT_GPU=0
APARTMINT_GPU_MEMORY=0.70
APARTMINT_VLLM_IMAGE=vllm/vllm-openai:v0.31.0-cu129
